#!/bin/sh
# /etc/init.d/rcS - BusyBox init startup script
# Adapted for Yocto embedded system, ARM64 architecture

# 1. Basic environment variable initialization
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export LD_LIBRARY_PATH=/usr/lib:/lib
export TERM=vt100

# 2. Print startup information
echo "======================================"
echo "Starting BusyBox Init (Yocto ARM64)..."
echo "======================================"

# 3. Mount core file systems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -o remount,rw /  # Remount root filesystem as read-write

# 4. Create necessary directories (to avoid startup failure)
mkdir -p /dev/pts /var/run /var/log /var/tmp
mount -t devpts devpts /dev/pts

# 5. Device node initialization (BusyBox mdev)
echo "Initializing device nodes..."
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s  # Scan and create device nodes

# 6. Network initialization (adjust according to your network configuration)
echo "Configuring network..."
ifconfig lo 127.0.0.1 up  # Loopback address
ifconfig eth0 192.168.1.100 netmask 255.255.255.0 up  # Static IP (modify as needed)
route add default gw 192.168.1.1  # Gateway (modify as needed)
echo "nameserver 8.8.8.8" > /etc/resolv.conf  # DNS

# 7. System parameter tuning (optional)
echo "Setting system parameters..."
echo 1 > /proc/sys/net/ipv4/ip_forward  # Enable IP forwarding (if needed)
ulimit -c unlimited  # Allow core dump

# 8. Start basic services (add as needed)
echo "Starting basic services..."
# Start SSH (dropbear, adapted for BusyBox)
if [ -x /usr/sbin/dropbear ]; then
    dropbear -p 22 -B  # Start dropbear in background
    echo "Dropbear SSH server started"
fi

# Start logging service (optional)
if [ -x /sbin/syslogd ]; then
    syslogd -n &
    klogd -n &
    echo "Syslog started"
fi

# 9. Mount additional partitions (if any, add as needed)
# mount /dev/mmcblk0p2 /mnt/data  # Example: Mount data partition

# 10. Startup completion message
echo "======================================"
echo "System boot completed (BusyBox Init)!"
echo "======================================"