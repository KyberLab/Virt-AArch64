		"description": "执行开源项目的 make 命令（build/clean/test 等），支持自定义参数",
		"command": "/opt/virt/KyberLab/Virt-AArch64/run-make-with-env.sh",
		"args": [],
		"cwd": "/opt/virt/KyberLab/Virt-AArch64",
		"env": {
